{
  "name": "video-scene-decomposer",
  "version": "1.0.0",
  "description": "Analyze videos scene-by-scene and export reusable visual elements with explicit provenance",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "test:serial": "node scripts/run-tests.js",
    "fixtures:legacy": "node scripts/make-fixtures.js",
    "fixtures:decomposer": "node scripts/make-decomposer-fixtures.js",
    "evaluate": "node scripts/evaluate-decomposer.js",
    "evaluate:scenes": "node scripts/evaluate-scene-detector.js",
    "baseline:legacy": "node scripts/benchmark-legacy-baseline.js",
    "acceptance:summary": "node scripts/summarize-editor-acceptance.js",
    "benchmark:providers": "node scripts/benchmark-live-providers.js",
    "check:config": "node scripts/check-config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4"
  }
}
